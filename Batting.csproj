<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- plain net7.0, not net7.0-windows, so the plug-in can also load in Rhino for Mac -->
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Batting</AssemblyName>
    <RootNamespace>Batting</RootNamespace>
    <Version>1.2.0</Version>
    <Authors>pbrgle1</Authors>
    <Description>Batting (insulation) symbol for Rhino 8 that follows its base curve.</Description>
    <!-- Produce a .rhp instead of .dll -->
    <TargetExt>.rhp</TargetExt>
    <!-- RhinoCommon's package only lists .NET Framework; Rhino 8 loads it on .NET 7/8 too -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- the oldest Rhino 8, so the package installs on every Rhino 8 -->
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- the Properties page icon, light and dark -->
    <EmbeddedResource Include="Resources\page.ico" LogicalName="Batting.page.ico" />
    <EmbeddedResource Include="Resources\page-dark.ico" LogicalName="Batting.page-dark.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- the Grasshopper components are a project of their own -->
    <Compile Remove="Grasshopper\**" />
    <EmbeddedResource Remove="Grasshopper\**" />
    <None Remove="Grasshopper\**" />
  </ItemGroup>

</Project>
